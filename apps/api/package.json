{
  "name": "@kaizen/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "prisma generate && find src -name '*.js' -print0 | xargs -0 -n 1 node --check && mkdir -p dist && cp -R src/. dist/",
    "job:finalize-days": "node dist/jobs/finalize-days.js"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@kaizen/contracts": "workspace:*",
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "express": "^5.0.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "pino": "^10.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
