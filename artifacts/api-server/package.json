{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node --watch src/server.js",
    "build": "prisma generate && find src -name '*.js' -print0 | xargs -0 -n 1 node --check && mkdir -p dist && cp -R src/. dist/",
    "start": "node --enable-source-maps ./dist/server.js",
    "db:migrate": "node src/ops/migrate.js",
    "job:finalize-days": "node src/jobs/finalize-days.js",
    "job:cleanup-sessions": "node src/jobs/cleanup-sessions.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.js"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@kaizen/contracts": "workspace:@workspace/kaizen-contracts@*",
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "pino": "^10.0.0",
    "prisma": "6.19.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "supertest": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
