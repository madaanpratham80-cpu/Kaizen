PORT=4000
NODE_ENV=development
AUTH_BCRYPT_COST=12
# List older bcrypt costs still present in stored hashes, separated by commas.
AUTH_BCRYPT_LEGACY_COSTS=
WEB_ORIGIN=http://localhost:3000
APP_ORIGIN=http://localhost:3000
TRUSTED_PROXY_IPS=
# Generate a server-only value with: openssl rand -hex 32
SESSION_SECRET=
DATABASE_URL=postgresql://kaizen:kaizen@localhost:5432/kaizen?schema=public
# Provide to the migration process only. Locally, the disposable development database may share credentials.
MIGRATION_DATABASE_URL=
DEPLOYMENT_VERSION=local
API_HOST=127.0.0.1
