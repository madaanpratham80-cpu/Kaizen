# Direct API address for the separate localhost development processes.
# Use /api/v1 in same-origin deployments.
NEXT_PUBLIC_API_BASE_PATH=http://localhost:4000/api/v1

# Server-only Express origin for Next.js session checks and /api/v1 rewrites.
# Omit the API path.
API_INTERNAL_ORIGIN=http://127.0.0.1:4000

# Set to 1 for a hosted deployment with real accounts. Explicit Guest Operator
# access still works, while failed account requests show the actual error.
NEXT_PUBLIC_REQUIRE_ACCOUNT_API=1
